# Auto Trader — environment variables (sanitized example)
# Copy to .env and fill in real values. NEVER commit .env.
# All variables are optional — the app works out-of-the-box with paper trading.

# SQLite database path (default: file:./db/custom.db)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# TypeSafe AI API key (optional — enables AI agent features)
TYPESAFE_API_KEY="replace-me"

# Google Safe Browsing v4 (optional — 4th scam-detection layer)
GOOGLE_SAFE_BROWSING_KEY="replace-me"

# CoinGecko API (optional — Demo plan: 30 req/min, 10k calls/mo; header x-cg-demo-api-key)
COINGECKO_API_KEY="replace-me"

# Etherscan API keys (optional — increases rate limits)
ETHERSCAN_API_KEY="replace-me"
ARBISCAN_API_KEY="replace-me"
BASESCAN_API_KEY="replace-me"
OPTIMISM_ETHERSCAN_API_KEY="replace-me"

TYPESAFE_API_KEY=

# Solscan Pro API (FREE Level 1 — 60 req/min, 10M CU/mês)
# Base: https://public-api.solscan.io — auth via header "token"
SOLSCAN_API_KEY="replace-me"

# Cardanoscan API (Free — 5 req/s, 100k calls/dia, Mainnet/Preprod/Preview)
# Base: https://api.cardanoscan.io/api/v1 — auth via header "apiKey"
# Nota: BSC (chainid=56) NÃO é coberta pelo free tier da Etherscan V2 — Polygon/BASE/Arbitrum/Optimism sim
CARDANOSCAN_API_KEY="replace-me"

# Slots Etherscan por chain (herdados do V1). Na API V2 todas usam a MESMA
# chave de ETHERSCAN_API_KEY — mantidos para compatibilidade/wiring futuro.
# Free tier V2 (validado 2026-11-01): Ethereum, Arbitrum e Celo OK; Polygon
# intermitente (#err2); Base/Optimism/BSC/Avalanche exigem plano Pro.
ARBISCAN_API_KEY="replace-me"
BASESCAN_API_KEY="replace-me"
OPTIMISM_ETHERSCAN_API_KEY="replace-me"

# Dados BSC sem explorer (free tier V2 exclui a BSC): RPC público JSON-RPC,
# separado por vírgulas para fallback. Consumido quando o runtime de chains
# (src/lib/chain) for ligado no S14; hoje o GoPlus já cobre BSC sem chave.
BSC_RPC_URL="https://bsc-dataseed.binance.org,https://bsc-rpc.publicnode.com"
