  "typography": {
    "families": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
      "serif": "'Source Serif 4', 'Source Serif Pro', Georgia, 'Times New Roman', serif",
      "mono": "ui-monospace, 'SF Mono', 'Cascadia Code', 'JetBrains Mono', Consolas, monospace"
    },
    "scale": {
      "display": { "size": 56, "lineHeight": 60, "weight": 500, "tracking": -0.02, "family": "serif" },
      "h1": { "size": 32, "lineHeight": 40, "weight": 600, "tracking": -0.02 },
      "h2": { "size": 24, "lineHeight": 32, "weight": 600, "tracking": -0.015 },
      "h3": { "size": 18, "lineHeight": 26, "weight": 600, "tracking": -0.01 },
      "body": { "size": 14, "lineHeight": 22, "weight": 400, "tracking": 0 },
      "body-sm": { "size": 13, "lineHeight": 20, "weight": 400, "tracking": 0 },
      "label": { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.01 },
      "caption": { "size": 11, "lineHeight": 14, "weight": 500, "tracking": 0.04, "transform": "uppercase" },
      "numeric-xl": { "size": 40, "lineHeight": 44, "weight": 600, "tracking": -0.02, "feature": "tnum" },
      "numeric-lg": { "size": 28, "lineHeight": 32, "weight": 600, "tracking": -0.01, "feature": "tnum" },
      "numeric": { "size": 14, "lineHeight": 20, "weight": 500, "tracking": 0, "feature": "tnum" }
    }
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80, "24": 96 },
  "radius": { "xs": 4, "sm": 6, "md": 8, "lg": 12, "xl": 16, "2xl": 20, "pill": 999 },
  "elevation": {
    "overlay": "0 32px 80px -24px rgba(0, 0, 0, 0.72), 0 2px 8px rgba(0, 0, 0, 0.32)",
    "popover": "0 16px 40px -16px rgba(0, 0, 0, 0.64)",
    "none": "none"
  },
  "layout": {
    "rail": { "expanded": 256, "collapsed": 72 },
    "topbar": 60,
    "telemetry": 34,
    "content-max": 1560,
    "content-padding": 32,
    "drawer": { "sm": 420, "md": 520, "lg": 680 },
    "modal": { "sm": 440, "md": 560, "lg": 720 }
  },
  "motion": {
    "instant": { "duration": 90, "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "fast": { "duration": 140, "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "base": { "duration": 200, "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "slow": { "duration": 320, "easing": "cubic-bezier(0.16, 1, 0.3, 1)" },
    "reduced": { "duration": 0 }
  },
  "breakpoints": { "sm": 640, "md": 900, "lg": 1200, "xl": 1440, "2xl": 1680 },
  "z": { "rail": 20, "topbar": 30, "drawer": 40, "modal": 50, "palette": 60, "toast": 70 }
}
