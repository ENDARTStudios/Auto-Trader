# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local SQLite dev database (created by prisma migrate deploy / db push).
# The schema is fully captured by prisma/migrations/ — a fresh clone should
# run `prisma migrate deploy` to recreate the DB, not inherit a dev artifact.
# Tracking db/custom.db caused REG-007: test runs mutated the committed DB,
# creating noise in commits and risking leakage of dev-only secrets.
db/*.db
db/*.db-journal
db/*.db-wal
db/*.db-shm
prisma/*.db
prisma/*.db-journal
prisma/*.db-wal
prisma/*.db-shm

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# tool-result scratch files (large file reads)
tool-results/
